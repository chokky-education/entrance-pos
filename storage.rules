rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow reading product images for POS display
    match /pos/items/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Deny all other storage paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}


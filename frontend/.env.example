SERVICE_BASE_URL=http://127.0.0.1:8085
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Cloudflare D1 Database
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_D1_DATABASE_ID=your_cloudflare_d1_database_id

# Cloudflare R2 Object Storage (สำหรับเก็บรูปเมนูสินค้าและใบเสร็จทั้งหมด)
R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=domepos-media
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.domepos.example.com

# ThaiFi Custody Wallet (สะสมแต้ม ครบ 100 บาท = 1 Point)
THAIFI_CUSTODY_URL=https://custody.thaifi.com
THAIFI_CUSTODY_API_KEY=your_thaifi_custody_api_key_here

# DOME Pos Backend Configuration (.env.example)
HTTP_PORT=8085

# Primary Cloud Database & Media Storage: Cloudflare D1 + Cloudflare R2 / Cloudflare Images
DB_PROVIDER=d1
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_cloudflare_d1_database_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Cloudflare R2 Object Storage & Cloudflare Images (สำหรับเก็บรูปเมนูร้านกาแฟและสลิปใบเสร็จทั้งหมด)
R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=domepos-media
R2_PUBLIC_URL=https://media.domepos.example.com
CLOUDFLARE_IMAGES_ACCOUNT_HASH=your_cloudflare_images_hash
CLOUDFLARE_IMAGES_TOKEN=your_cloudflare_images_token

# Local PostgreSQL Fallback (สำหรับรันเทสต์ UAT บนเครื่อง - ห้ามใช้ smldemo)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=example_password_do_not_use
PG_DATABASE=domepos
PG_SSLMODE=disable

# ThaiFi Custody Wallet (สะสมแต้มอัตโนมัติ ซื้อครบทุก 100 บาท = 1 Point)
THAIFI_CUSTODY_URL=https://custody.thaifi.com
THAIFI_CUSTODY_API_KEY=your_thaifi_custody_api_key_here

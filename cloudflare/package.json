{
  "name": "domepos-cloudflare",
  "version": "1.0.0",
  "private": true,
  "description": "DOME Pos Cloudflare Edge Stack (D1 Database + R2 Image Storage + KV + Queues + Durable Objects KDS + Workers AI)",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "d1:init:local": "wrangler d1 execute domepos-d1 --local --file=./schema.d1.sql",
    "d1:init:remote": "wrangler d1 execute domepos-d1 --remote --file=./schema.d1.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
